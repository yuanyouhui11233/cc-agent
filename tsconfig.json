{
  "compilerOptions": {
    "module": "Node16",
    "target": "ES2022",
    "noImplicitAny": false,
    "strict": true,
    "moduleResolution": "Node16",
    "sourceMap": true,
    "outDir": "dist",
    "experimentalDecorators": true,
    "emitDecoratorMetadata": true,
    "skipLibCheck": true,
    "incremental": true,
    "types": ["node"]
  },
  "include": ["src/**/*", "prisma.config.ts"],
  "exclude": ["node_modules", "dist", "src/**/*.spec.ts"]
}
